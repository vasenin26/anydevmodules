# ═══════════════════════════════════════════════════════════════
# AnyModule — переменные для docker-compose.yaml
# cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── docmodule ─────────────────────────────────────────────────
# Обязательно. Сгенерировать: echo "base64:$(openssl rand -base64 32)"
# Этим ключом подписываются JWT агентов — при смене все токены станут невалидны.
APP_KEY=
APP_ENV=local
APP_DEBUG=true

# Внешний адрес docmodule (браузер) и порт на хосте
DOCMODULE_URL=http://localhost:8000
DOCMODULE_PORT=8000

REGISTRATION_REQUEST_ONLY=false
REGISTRATION_REQUEST_ADMIN_EMAIL=admin@example.com

# ─── PostgreSQL ────────────────────────────────────────────────
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel
DB_PORT_HOST=5432

# ─── agentmanager ──────────────────────────────────────────────
AGENTMANAGER_PORT=8080

# JWT агента из docmodule (Проект → Агенты → создать агента / перевыпустить токен).
# Используется и для /api/orchestrator/*, и передаётся агентам как API_TOKEN.
# Пока пусто — agentmanager будет получать 401 от docmodule.
ORCHESTRATOR_TOKEN=

TASK_API_TIMEOUT=10s
TASK_POLL_INTERVAL=5s

# Образ агента: по умолчанию собирается локально сервисом agentmodule.
# Для образа из реестра: AGENT_IMAGE=ghcr.io/vasenin26/agentmodule:latest, AGENT_IMAGE_PULL=true
AGENT_IMAGE=anymodule/agentmodule:local
AGENT_IMAGE_PULL=false
AGENT_MEMORY_LIMIT_MB=512

# Адрес docmodule API, видимый ИЗ контейнеров агентов.
# Агенты запускаются в bridge-сети Docker (не в сети compose), поэтому ходят через хост:
#   Docker Desktop (Windows/macOS/WSL2): http://host.docker.internal:8000/api
#   Docker Engine на Linux:              http://172.17.0.1:8000/api
AGENT_API_HOST=http://host.docker.internal:8000/api

# Доступ к приватному реестру (если AGENT_IMAGE_PULL=true)
REGISTRY_SERVER=ghcr.io
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# ─── LLM (прокидывается агентам и в docmodule) ─────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Совместимый с OpenAI endpoint (прокси, GigaChat-шлюз и т.п.), пусто = api.openai.com
OPENAI_API_HOST=

# ─── Git (коммиты агентов) ─────────────────────────────────────
GIT_USER_NAME=AnyModule Agent
GIT_USER_EMAIL=agent@example.com
